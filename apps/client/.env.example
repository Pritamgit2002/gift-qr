# Copy to apps/client/.env.local

# Auth.js secret: generate with `openssl rand -base64 32`.
# Must be the same value as AUTH_SECRET in apps/server/.env.
AUTH_SECRET=

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public address of this site, used for share images and icons.
SITE_URL=http://localhost:3000

# Needed by `next start` outside Vercel: lets Auth.js trust the request's Host header.
# Only set it behind a proxy or host that sets Host itself.
AUTH_TRUST_HOST=true

# Where the API server runs. Used by the /api/server proxy and server-side fetches.
SERVER_URL=http://localhost:4000

# Razorpay public key for the checkout widget
NEXT_PUBLIC_RAZORPAY_TEST_KEY_ID=
