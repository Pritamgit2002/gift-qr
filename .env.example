# GiftQR environment variables, all in one place.
#
# Each app reads its own file, so split these up:
#   Client section -> apps/client/.env.local
#   Server section -> apps/server/.env
# (apps/client/.env.example and apps/server/.env.example hold the same lists.)

# ---------------------------------------------------------------------------
# Shared: must be the SAME value in both files.
# Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Client (apps/client/.env.local)
# ---------------------------------------------------------------------------
# Google OAuth client (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the API server runs. Used by the /api/server proxy and server-side fetches.
SERVER_URL=http://localhost:4000

# Razorpay public key for the checkout widget
NEXT_PUBLIC_RAZORPAY_TEST_KEY_ID=

# Needed by `next start` outside Vercel: lets Auth.js trust the request's Host header.
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# Server (apps/server/.env)
# ---------------------------------------------------------------------------
PORT=4000

MONGODB_SERVER_URL=
MONGODB_DB_NAME=

# S3 bucket that stores list and draft images
CUSTOM_AWS_BUCKET_NAME=
CUSTOM_AWS_BUCKET_REGION=
CUSTOM_AWS_ACCESS_KEY=
CUSTOM_AWS_SECRET_KEY=

RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_SECRET_KEY=
